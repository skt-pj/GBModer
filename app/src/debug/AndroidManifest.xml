<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application>
        <activity
            android:name=".LiveModePaywallActivity"
            android:enabled="${debugFeaturesEnabled}"
            android:exported="false" />

        <activity
            android:name=".VideoDiagnosticsActivity"
            android:enabled="${debugFeaturesEnabled}"
            android:exported="false" />

        <service
            android:name=".FilterAccessibilityService"
            android:enabled="${debugFeaturesEnabled}"
            android:exported="true"
            android:label="@string/accessibility_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <service
            android:name=".FilterCaptureService"
            android:enabled="${debugFeaturesEnabled}"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

        <receiver
            android:name=".FilterControlReceiver"
            android:enabled="${debugFeaturesEnabled}"
            android:exported="false" />
    </application>

</manifest>
